{
  "name": "sourcedao",
  "version": "1.0.0",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.12.0",
    "npm": "11.6.2"
  },
  "type": "module",
  "description": "",
  "main": "index.js",
  "directories": {
    "abi": "npx hardhat compile",
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "verify:toolchain": "node scripts/verify_ci_toolchain.mjs",
    "clean": "hardhat clean",
    "build": "hardhat build",
    "clean:usdb": "rm -rf artifacts-usdb cache-usdb",
    "build:usdb": "npm run clean:usdb && SOURCE_DAO_ARTIFACTS_DIR=./artifacts-usdb SOURCE_DAO_CACHE_DIR=./cache-usdb hardhat build --build-profile usdb",
    "generate:usdb:golden": "node scripts/generate_usdb_contract_golden.mjs",
    "test": "hardhat test",
    "test:usdb:audit": "node scripts/audit_usdb_bytecode.mjs",
    "test:usdb:golden": "node scripts/generate_usdb_contract_golden.mjs --check",
    "test:usdb:compile-and-audit": "npm run build:usdb && npm run test:usdb:audit && npm run test:usdb:golden",
    "test:usdb:fast": "npm run verify:toolchain && npm test && npm run test:usdb:compile-and-audit && npm run test:usdb:tools",
    "test:usdb:smoke": "tsx scripts/usdb_bootstrap_smoke.ts",
    "validate:bootstrap": "tsx scripts/usdb_validate_bootstrap.ts",
    "bootstrap:smoke": "tsx scripts/usdb_validate_bootstrap.ts",
    "upgrade:existing": "tsx scripts/upgrade_existing_sourcedao.ts",
    "node:local": "hardhat node --hostname 127.0.0.1 --port 8545",
    "deploy:frontend-local": "hardhat run scripts/deploy_frontend_local.ts --network localhost",
    "deploy:frontend-local:write": "FRONTEND_ENV_OUTPUT=default hardhat run scripts/deploy_frontend_local.ts --network localhost",
    "seed:local": "SOURCE_DAO_LOCAL_SCENARIO=full-ui hardhat run scripts/seed_local_scenarios.ts --network localhost",
    "stack:local": "bash scripts/local_dev_stack.sh",
    "stack:local:stop": "bash scripts/stop_local_dev_stack.sh",
    "stack:local:reset": "bash scripts/local_dev_stack.sh --reset",
    "test:usdb:tools:typecheck": "tsc --noEmit --strict --target es2022 --module nodenext --moduleResolution nodenext --esModuleInterop --skipLibCheck scripts/usdb_bootstrap_full.ts scripts/usdb_validate_bootstrap.ts scripts/usdb_import_bootstrap_source.ts scripts/usdb_export_bootstrap_state.ts scripts/usdb_bootstrap_tools.ts scripts/usdb_check_bootstrap.ts",
    "test:usdb:tools": "npm run test:usdb:tools:typecheck && node --import tsx --test tests/bootstrap_*.test.ts",
    "import:bootstrap:source": "tsx scripts/usdb_import_bootstrap_source.ts",
    "export:bootstrap:state": "tsx scripts/usdb_export_bootstrap_state.ts",
    "prepare:bootstrap": "tsx scripts/usdb_bootstrap_tools.ts prepare",
    "freeze:bootstrap": "tsx scripts/usdb_bootstrap_tools.ts freeze",
    "bootstrap:full": "tsx scripts/usdb_bootstrap_full.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://www.github.com/buckyos/SourceDao"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "json-bigint": "^1.0.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.13",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.10",
    "@nomicfoundation/hardhat-mocha": "^3.0.21",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.10",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@openzeppelin/hardhat-upgrades": "^4.0.2",
    "@types/chai": "^4.3.20",
    "@types/deep-equal-in-any-order": "^1.0.4",
    "@types/json-bigint": "^1.0.4",
    "@types/mocha": "^10.0.10",
    "chai": "^5.2.0",
    "deep-equal-in-any-order": "^2.2.0",
    "ethers": "^6.17.0",
    "hardhat": "^3.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "tsx": "4.22.4"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5"
    }
  }
}
